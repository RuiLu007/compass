{
  "type": "function",
  "function": {
    "name": "todo_write",
    "description": "**用途与调用规则**\n\n- 登记、选择、完成或跳过任务事项，提交当前 baseVersion。",
    "parameters": {
      "type": "object",
      "$defs": {
        "CompleteTodo": {
          "additionalProperties": false,
          "properties": {
            "baseVersion": {
              "maximum": 400,
              "minimum": 0,
              "title": "Baseversion",
              "type": "integer"
            },
            "op": {
              "const": "complete",
              "title": "Op",
              "type": "string"
            },
            "todoId": {
              "pattern": "^t[1-9][0-9]{0,2}$",
              "title": "Todoid",
              "type": "string"
            },
            "selectTodoId": {
              "anyOf": [
                {
                  "pattern": "^t[1-9][0-9]{0,2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Selecttodoid"
            }
          },
          "required": ["baseVersion", "op", "todoId"],
          "title": "CompleteTodo",
          "type": "object"
        },
        "ReplaceTodo_TodoDefinition_": {
          "additionalProperties": false,
          "properties": {
            "baseVersion": {
              "maximum": 400,
              "minimum": 0,
              "title": "Baseversion",
              "type": "integer"
            },
            "op": {
              "const": "replace",
              "title": "Op",
              "type": "string"
            },
            "items": {
              "items": {
                "$ref": "#/$defs/TodoDefinition"
              },
              "maxItems": 6,
              "minItems": 1,
              "title": "Items",
              "type": "array"
            },
            "selectTodoId": {
              "anyOf": [
                {
                  "pattern": "^t[1-9][0-9]{0,2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Selecttodoid"
            }
          },
          "required": ["baseVersion", "op", "items"],
          "title": "ReplaceTodo[TodoDefinition]",
          "type": "object"
        },
        "SelectTodo": {
          "additionalProperties": false,
          "properties": {
            "baseVersion": {
              "maximum": 400,
              "minimum": 0,
              "title": "Baseversion",
              "type": "integer"
            },
            "op": {
              "const": "select",
              "title": "Op",
              "type": "string"
            },
            "todoId": {
              "pattern": "^t[1-9][0-9]{0,2}$",
              "title": "Todoid",
              "type": "string"
            }
          },
          "required": ["baseVersion", "op", "todoId"],
          "title": "SelectTodo",
          "type": "object"
        },
        "SkipReason": {
          "enum": ["out_of_scope", "duplicate_optional"],
          "type": "string"
        },
        "SkipTodo": {
          "additionalProperties": false,
          "properties": {
            "baseVersion": {
              "maximum": 400,
              "minimum": 0,
              "title": "Baseversion",
              "type": "integer"
            },
            "op": {
              "const": "skip",
              "title": "Op",
              "type": "string"
            },
            "todoId": {
              "pattern": "^t[1-9][0-9]{0,2}$",
              "title": "Todoid",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/SkipReason"
            }
          },
          "required": ["baseVersion", "op", "todoId", "reason"],
          "title": "SkipTodo",
          "type": "object"
        },
        "TodoDefinition": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^t[1-9][0-9]{0,2}$",
              "title": "Id",
              "type": "string"
            },
            "goal": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Goal",
              "type": "string"
            },
            "dependsOn": {
              "items": {
                "pattern": "^t[1-9][0-9]{0,2}$",
                "type": "string"
              },
              "maxItems": 5,
              "title": "Dependson",
              "type": "array"
            },
            "optional": {
              "default": false,
              "title": "Optional",
              "type": "boolean"
            }
          },
          "required": ["id", "goal"],
          "title": "TodoDefinition",
          "type": "object"
        }
      },
      "discriminator": {
        "mapping": {
          "complete": "#/$defs/CompleteTodo",
          "replace": "#/$defs/ReplaceTodo_TodoDefinition_",
          "select": "#/$defs/SelectTodo",
          "skip": "#/$defs/SkipTodo"
        },
        "propertyName": "op"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ReplaceTodo_TodoDefinition_"
        },
        {
          "$ref": "#/$defs/SelectTodo"
        },
        {
          "$ref": "#/$defs/CompleteTodo"
        },
        {
          "$ref": "#/$defs/SkipTodo"
        }
      ]
    }
  },
  "examples": []
}
