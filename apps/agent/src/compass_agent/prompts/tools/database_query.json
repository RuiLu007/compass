{
  "type": "function",
  "function": {
    "name": "database_query",
    "description": "列出可查询的表、查看字段，或执行一条只读 PostgreSQL SELECT。先用 list_connections 发现连接，多个连接时指定 connectionId。SQL 使用 schema.table。最多返回 50 行、4 KiB。",
    "parameters": {
      "type": "object",
      "$defs": {
        "DescribeTable": {
          "additionalProperties": false,
          "properties": {
            "connectionId": {
              "anyOf": [
                {
                  "maxLength": 36,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Connectionid"
            },
            "op": {
              "const": "describe_table",
              "title": "Op",
              "type": "string"
            },
            "schema": {
              "maxLength": 63,
              "minLength": 1,
              "title": "Schema",
              "type": "string"
            },
            "table": {
              "maxLength": 63,
              "minLength": 1,
              "title": "Table",
              "type": "string"
            },
            "offset": {
              "default": 0,
              "maximum": 10000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          "required": ["op", "schema", "table"],
          "title": "DescribeTable",
          "type": "object"
        },
        "ListConnections": {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "list_connections",
              "title": "Op",
              "type": "string"
            }
          },
          "required": ["op"],
          "title": "ListConnections",
          "type": "object"
        },
        "ListTables": {
          "additionalProperties": false,
          "properties": {
            "connectionId": {
              "anyOf": [
                {
                  "maxLength": 36,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Connectionid"
            },
            "op": {
              "const": "list_tables",
              "title": "Op",
              "type": "string"
            },
            "offset": {
              "default": 0,
              "maximum": 10000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          "required": ["op"],
          "title": "ListTables",
          "type": "object"
        },
        "ReadSql": {
          "additionalProperties": false,
          "properties": {
            "connectionId": {
              "anyOf": [
                {
                  "maxLength": 36,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Connectionid"
            },
            "op": {
              "const": "query",
              "title": "Op",
              "type": "string"
            },
            "sql": {
              "maxLength": 8192,
              "minLength": 1,
              "title": "Sql",
              "type": "string"
            }
          },
          "required": ["op", "sql"],
          "title": "ReadSql",
          "type": "object"
        }
      },
      "discriminator": {
        "mapping": {
          "describe_table": "#/$defs/DescribeTable",
          "list_connections": "#/$defs/ListConnections",
          "list_tables": "#/$defs/ListTables",
          "query": "#/$defs/ReadSql"
        },
        "propertyName": "op"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ListConnections"
        },
        {
          "$ref": "#/$defs/ListTables"
        },
        {
          "$ref": "#/$defs/DescribeTable"
        },
        {
          "$ref": "#/$defs/ReadSql"
        }
      ]
    }
  },
  "examples": []
}
