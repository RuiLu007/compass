{
  "type": "function",
  "function": {
    "name": "schedule_read",
    "description": "列出、搜索当前用户的定时任务，或按 ID 查看详情及执行记录。按名称修改或删除前先查询，遇到同名任务请用户选择。",
    "parameters": {
      "type": "object",
      "$defs": {
        "ScheduleGetArgs": {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "get",
              "title": "Operation",
              "type": "string"
            },
            "scheduleId": {
              "format": "uuid",
              "title": "Scheduleid",
              "type": "string"
            }
          },
          "required": ["operation", "scheduleId"],
          "title": "ScheduleGetArgs",
          "type": "object"
        },
        "ScheduleHistoryArgs": {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "history",
              "title": "Operation",
              "type": "string"
            },
            "scheduleId": {
              "format": "uuid",
              "title": "Scheduleid",
              "type": "string"
            },
            "cursor": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cursor"
            }
          },
          "required": ["operation", "scheduleId"],
          "title": "ScheduleHistoryArgs",
          "type": "object"
        },
        "ScheduleListArgs": {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "list",
              "title": "Operation",
              "type": "string"
            },
            "q": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Q"
            },
            "status": {
              "anyOf": [
                {
                  "enum": ["enabled", "disabled", "deleted"],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Status"
            },
            "cursor": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cursor"
            }
          },
          "required": ["operation"],
          "title": "ScheduleListArgs",
          "type": "object"
        }
      },
      "discriminator": {
        "mapping": {
          "get": "#/$defs/ScheduleGetArgs",
          "history": "#/$defs/ScheduleHistoryArgs",
          "list": "#/$defs/ScheduleListArgs"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ScheduleListArgs"
        },
        {
          "$ref": "#/$defs/ScheduleGetArgs"
        },
        {
          "$ref": "#/$defs/ScheduleHistoryArgs"
        }
      ]
    }
  },
  "examples": []
}
