{
  "type": "function",
  "function": {
    "name": "final_answer",
    "description": "- 提交待校验的最终回答；单独调用。\n- plain 用于概念、澄清、操作说明和无资料状态；evidence 用于查询事实、公司资料及其解释建议。填写原问题已覆盖目标与未解决项。evidence 使用工具回执中的 evidenceId 和原文/结果格定位，claimId 可引用已支持结论。候选会经通用 Verify 再发布；反馈可能要求补查或修订。",
    "parameters": {
      "type": "object",
      "$defs": {
        "AnswerArtifact": {
          "additionalProperties": false,
          "properties": {
            "format": {
              "enum": ["markdown", "csv", "dashboard"],
              "title": "Format",
              "type": "string"
            },
            "title": {
              "maxLength": 160,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "evidenceIds": {
              "items": {
                "type": "string"
              },
              "maxItems": 24,
              "title": "Evidenceids",
              "type": "array"
            }
          },
          "required": ["format", "title"],
          "title": "AnswerArtifact",
          "type": "object"
        },
        "Block": {
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": ["paragraph", "list", "comparison_table"],
              "title": "Type",
              "type": "string"
            },
            "claimIds": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Claimids",
              "type": "array"
            },
            "text": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Text"
            }
          },
          "required": ["type", "claimIds"],
          "title": "Block",
          "type": "object"
        },
        "Calculation": {
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": ["sum", "difference", "ratio", "percent_change"],
              "title": "Op",
              "type": "string"
            },
            "inputs": {
              "items": {
                "$ref": "#/$defs/SourceRef"
              },
              "maxItems": 32,
              "minItems": 1,
              "title": "Inputs",
              "type": "array"
            },
            "unit": {
              "default": "",
              "title": "Unit",
              "type": "string"
            }
          },
          "required": ["op", "inputs"],
          "title": "Calculation",
          "type": "object"
        },
        "Claim": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "minLength": 1,
              "title": "Id",
              "type": "string"
            },
            "kind": {
              "enum": ["fact", "interpretation", "recommendation"],
              "title": "Kind",
              "type": "string"
            },
            "text": {
              "minLength": 1,
              "title": "Text",
              "type": "string"
            },
            "refs": {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SourceRef"
                  },
                  {
                    "$ref": "#/$defs/ClaimRef"
                  }
                ]
              },
              "minItems": 1,
              "title": "Refs",
              "type": "array"
            },
            "calculation": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Calculation"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": ["id", "kind", "text", "refs"],
          "title": "Claim",
          "type": "object"
        },
        "ClaimRef": {
          "additionalProperties": false,
          "properties": {
            "claimId": {
              "title": "Claimid",
              "type": "string"
            }
          },
          "required": ["claimId"],
          "title": "ClaimRef",
          "type": "object"
        },
        "EvidenceAnswer": {
          "additionalProperties": false,
          "properties": {
            "completion": {
              "enum": ["complete", "partial"],
              "title": "Completion",
              "type": "string"
            },
            "coveredGoalIds": {
              "items": {
                "type": "string"
              },
              "title": "Coveredgoalids",
              "type": "array"
            },
            "unresolved": {
              "items": {
                "$ref": "#/$defs/Gap"
              },
              "title": "Unresolved",
              "type": "array"
            },
            "artifact": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AnswerArtifact"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "mode": {
              "const": "evidence",
              "title": "Mode",
              "type": "string"
            },
            "claims": {
              "items": {
                "$ref": "#/$defs/Claim"
              },
              "minItems": 1,
              "title": "Claims",
              "type": "array"
            },
            "blocks": {
              "items": {
                "$ref": "#/$defs/Block"
              },
              "minItems": 1,
              "title": "Blocks",
              "type": "array"
            }
          },
          "required": ["completion", "coveredGoalIds", "unresolved", "mode", "claims", "blocks"],
          "title": "EvidenceAnswer",
          "type": "object"
        },
        "Gap": {
          "additionalProperties": false,
          "properties": {
            "goalId": {
              "minLength": 1,
              "title": "Goalid",
              "type": "string"
            },
            "reason": {
              "minLength": 1,
              "title": "Reason",
              "type": "string"
            },
            "nextStep": {
              "minLength": 1,
              "title": "Nextstep",
              "type": "string"
            }
          },
          "required": ["goalId", "reason", "nextStep"],
          "title": "Gap",
          "type": "object"
        },
        "PlainAnswer": {
          "additionalProperties": false,
          "properties": {
            "completion": {
              "enum": ["complete", "partial"],
              "title": "Completion",
              "type": "string"
            },
            "coveredGoalIds": {
              "items": {
                "type": "string"
              },
              "title": "Coveredgoalids",
              "type": "array"
            },
            "unresolved": {
              "items": {
                "$ref": "#/$defs/Gap"
              },
              "title": "Unresolved",
              "type": "array"
            },
            "artifact": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AnswerArtifact"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "mode": {
              "const": "plain",
              "title": "Mode",
              "type": "string"
            },
            "body": {
              "minLength": 1,
              "title": "Body",
              "type": "string"
            }
          },
          "required": ["completion", "coveredGoalIds", "unresolved", "mode", "body"],
          "title": "PlainAnswer",
          "type": "object"
        },
        "SourceRef": {
          "additionalProperties": false,
          "properties": {
            "evidenceId": {
              "title": "Evidenceid",
              "type": "string"
            },
            "paragraphId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Paragraphid"
            },
            "start": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Start"
            },
            "end": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "End"
            },
            "row": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Row"
            },
            "column": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Column"
            },
            "artifactId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Artifactid"
            }
          },
          "required": ["evidenceId"],
          "title": "SourceRef",
          "type": "object"
        }
      },
      "discriminator": {
        "mapping": {
          "evidence": "#/$defs/EvidenceAnswer",
          "plain": "#/$defs/PlainAnswer"
        },
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PlainAnswer"
        },
        {
          "$ref": "#/$defs/EvidenceAnswer"
        }
      ]
    }
  },
  "examples": []
}
