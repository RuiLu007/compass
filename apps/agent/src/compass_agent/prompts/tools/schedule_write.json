{
  "type": "function",
  "function": {
    "name": "schedule_write",
    "description": "**用途与调用规则**\n\n- 创建、修改、启停或软删除定时任务，执行前由任务所有者确认。\n- 单独调用。\n- 修改与删除先查询并提供 ID 和当前版本；时间或目标含糊时先询问。\n- 创建需要名称、分析问题、模型选择、五段 Cron 和 IANA 时区。\n- 启停和删除不会取消已经受理的运行。",
    "parameters": {
      "type": "object",
      "$defs": {
        "MainModelSelection": {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": ["fixed", "auto"],
              "title": "Mode",
              "type": "string"
            },
            "provider_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Provider Id"
            }
          },
          "required": ["mode"],
          "title": "MainModelSelection",
          "type": "object"
        },
        "RunConstraints": {
          "additionalProperties": false,
          "properties": {
            "plan": {
              "anyOf": [
                {
                  "const": "required",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Plan"
            },
            "maxSteps": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Maxsteps"
            },
            "timeoutSeconds": {
              "anyOf": [
                {
                  "maximum": 600,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Timeoutseconds"
            }
          },
          "title": "RunConstraints",
          "type": "object"
        },
        "RunPeriod": {
          "additionalProperties": false,
          "properties": {
            "start": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "title": "Start",
              "type": "string"
            },
            "end": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "title": "End",
              "type": "string"
            }
          },
          "required": ["start", "end"],
          "title": "RunPeriod",
          "type": "object"
        },
        "ScheduleCreateArgs": {
          "additionalProperties": false,
          "properties": {
            "question": {
              "maxLength": 8000,
              "minLength": 1,
              "title": "Question",
              "type": "string"
            },
            "selection": {
              "$ref": "#/$defs/MainModelSelection"
            },
            "workflowAssetRef": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WorkflowAssetRef"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "constraints": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RunConstraints"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "name": {
              "maxLength": 120,
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "cron": {
              "maxLength": 120,
              "minLength": 1,
              "title": "Cron",
              "type": "string"
            },
            "timezone": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Timezone",
              "type": "string"
            },
            "enabled": {
              "default": true,
              "title": "Enabled",
              "type": "boolean"
            },
            "operation": {
              "const": "create",
              "title": "Operation",
              "type": "string"
            }
          },
          "required": ["question", "selection", "name", "cron", "timezone", "operation"],
          "title": "ScheduleCreateArgs",
          "type": "object"
        },
        "ScheduleDeleteArgs": {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "delete",
              "title": "Operation",
              "type": "string"
            },
            "scheduleId": {
              "format": "uuid",
              "title": "Scheduleid",
              "type": "string"
            },
            "expectedRevision": {
              "minimum": 1,
              "title": "Expectedrevision",
              "type": "integer"
            }
          },
          "required": ["operation", "scheduleId", "expectedRevision"],
          "title": "ScheduleDeleteArgs",
          "type": "object"
        },
        "SchedulePatch": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Name"
            },
            "question": {
              "anyOf": [
                {
                  "maxLength": 8000,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Question"
            },
            "selection": {
              "anyOf": [
                {
                  "$ref": "#/$defs/MainModelSelection"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "cron": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cron"
            },
            "timezone": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Timezone"
            },
            "enabled": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Enabled"
            },
            "workflowAssetRef": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WorkflowAssetRef"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "constraints": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RunConstraints"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "title": "SchedulePatch",
          "type": "object"
        },
        "ScheduleUpdateArgs": {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "update",
              "title": "Operation",
              "type": "string"
            },
            "scheduleId": {
              "format": "uuid",
              "title": "Scheduleid",
              "type": "string"
            },
            "expectedRevision": {
              "minimum": 1,
              "title": "Expectedrevision",
              "type": "integer"
            },
            "patch": {
              "$ref": "#/$defs/SchedulePatch"
            }
          },
          "required": ["operation", "scheduleId", "expectedRevision", "patch"],
          "title": "ScheduleUpdateArgs",
          "type": "object"
        },
        "WorkflowAssetRef": {
          "additionalProperties": false,
          "properties": {
            "baseline": {
              "$ref": "#/$defs/RunPeriod"
            },
            "current": {
              "$ref": "#/$defs/RunPeriod"
            },
            "assetId": {
              "format": "uuid",
              "title": "Assetid",
              "type": "string"
            },
            "definitionVersion": {
              "const": 1,
              "title": "Definitionversion",
              "type": "integer"
            }
          },
          "required": ["baseline", "current", "assetId", "definitionVersion"],
          "title": "WorkflowAssetRef",
          "type": "object"
        }
      },
      "discriminator": {
        "mapping": {
          "create": "#/$defs/ScheduleCreateArgs",
          "delete": "#/$defs/ScheduleDeleteArgs",
          "update": "#/$defs/ScheduleUpdateArgs"
        },
        "propertyName": "operation"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ScheduleCreateArgs"
        },
        {
          "$ref": "#/$defs/ScheduleUpdateArgs"
        },
        {
          "$ref": "#/$defs/ScheduleDeleteArgs"
        }
      ]
    }
  },
  "examples": []
}
