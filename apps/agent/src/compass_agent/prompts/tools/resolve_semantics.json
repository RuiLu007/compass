{
  "type": "function",
  "function": {
    "name": "resolve_semantics",
    "description": "解析本次提问指向的正式指标。多个合法口径时由原会话用户选择。用签发的 query_ref 计算。\n正式取数需在 parameters 中提交 start 和 end，并指定需要的分组及过滤。服务端按 Run 的受理时刻填写 as_of，仅在用户明确指定历史数据截止时提交 historical_as_of。query_metric 复用返回的规范化参数。\n\nprevious_equal_window 提供紧邻本期且天数相同的上一业务日期区间，使用相同分组、筛选和截止时刻。\n\n若收到 invalid_parameters，请按 field、filter_types 和 group_by_options 修正。筛选值使用绑定要求的 JSON 类型，编号型维度填整数。",
    "parameters": {
      "$defs": {
        "Parameters": {
          "additionalProperties": false,
          "properties": {
            "start": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "title": "Start",
              "type": "string"
            },
            "end": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "title": "End",
              "type": "string"
            },
            "as_of": {
              "anyOf": [
                {
                  "maxLength": 40,
                  "minLength": 16,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "As Of"
            },
            "group_by": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Group By"
            },
            "filters": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "maxProperties": 32,
              "title": "Filters",
              "type": "object"
            }
          },
          "required": ["start", "end"],
          "title": "Parameters",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "mention": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Mention",
          "type": "string"
        },
        "metric_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        },
        "dimensions": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Dimensions",
          "type": "array"
        },
        "parameters": {
          "anyOf": [
            {
              "$ref": "#/$defs/Parameters"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "historical_as_of": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "User-specified historical data cutoff; omit to use the Run start.",
          "title": "Historical As Of"
        }
      },
      "required": ["mention"],
      "title": "Input",
      "type": "object"
    }
  },
  "examples": []
}
