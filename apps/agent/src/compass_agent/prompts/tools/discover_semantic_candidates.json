          "description": "可选。用户指的是刚才的查询时可以省略，系统会在当前会话查找并让用户选择。",
          "title": "Result Ref"
        },
        "trigger": {
          "default": "requested",
          "description": "用户要求保存或选择时为 requested。只有主动推荐时填 suggest。",
          "enum": ["requested", "suggest"],
          "title": "Trigger",
          "type": "string"
