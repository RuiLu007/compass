              "maxLength": 400,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "主动推荐时说明哪些经营决策会跨期重复使用这项计算。",
          "title": "Reuse Reason"
        },
        "fields": {
          "anyOf": [
            {
              "$ref": "#/$defs/SuggestedDraftFields"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Input",
      "type": "object"
    }
  },
  "examples": []
