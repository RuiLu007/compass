{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["PYTHON_TOOLCHAIN_ID"]
    },
    "lint": {
      "env": ["PYTHON_TOOLCHAIN_ID"]
    },
    "typecheck": {
      "env": ["PYTHON_TOOLCHAIN_ID"]
    },
    "test": {
      "env": ["PYTHON_TOOLCHAIN_ID"]
    },
    "dev": {
      "passThroughEnv": [
        "$TURBO_EXTENDS$",
        "COMPASS_WORKER_ID",
        "COMPASS_WORKER_TOKEN",
        "COMPASS_RUNTIME_LEASE_SECONDS"
      ]
    }
  }
}
