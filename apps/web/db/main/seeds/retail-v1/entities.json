      "table": "tenant",
      "primary_key": ["tenant_id"],
      "event_time": "数据发布时冻结",
      "visible_time": "随连接固定的数据集发布读取（租户表 tenant.release_id）",
      "fields": {
        "tenant_code": "企业代码",
