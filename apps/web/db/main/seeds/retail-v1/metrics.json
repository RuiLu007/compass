[
  {
    "code": "sales.order_count",
    "name": "下单订单数",
    "domain": "sales",
    "owners": ["platform"],
    "responsible": "平台经营指标负责人",
    "summary": "按原销售归属统计期间内创建的订单。",
    "grain": "每租户每张订单一次",
    "unit": "order",
    "definition": {
      "formula": "COUNT(期间内创建的订单)",
      "components": "唯一订单",
      "aggregation": "订单头计数；跨商品集合重新去重。",
      "event_time": "下单时刻",
      "timezone": "Asia/Shanghai",
      "calendar": "公历自然日，ISO 周",
      "window": "[start,end)",
      "known_at": "available_at <= as_of",
      "exceptions": "保留取消单；一单包含多个指定商品时只计一次；空销售网点保留未归属。",
      "dimensions": ["day", "channel", "region", "site"],
      "filters": ["channel", "region", "site", "sku", "spu", "category"],
      "display": "整数单",
      "additivity": "additive_across_disjoint_order_sets"
    },
    "aliases": ["下单数", "订单数"],
    "binding": {
      "sources": ["order_header", "order_line", "sku", "spu", "source_watermark"],
      "fragments": ["orders", "watermarks", "additive"],
      "access": "regional",
      "watermarks": ["OMS"],
      "start": "2023-01-01",
      "end": "2026-01-01",
      "statuses": ["SOURCE_DELAYED", "COVERAGE_UNKNOWN", "NO_FACTS"]
    }
  },
  {
    "code": "sales.paid_gmv",
    "name": "支付 GMV",
    "domain": "sales",
    "owners": ["101.sales", "102.sales"],
    "responsible": "销售运营负责人",
