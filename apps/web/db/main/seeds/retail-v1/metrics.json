      "start": "2023-01-01",
      "end": "2026-04-01",
      "statuses": ["SOURCE_DELAYED", "COVERAGE_UNKNOWN", "NO_FACTS"]
    }
  },
  {
    "code": "sales.net_gmv",
    "name": "现金流净 GMV",
    "domain": "sales",
    "owners": ["101", "102"],
    "responsible": "租户经营负责人",
