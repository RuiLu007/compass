  {
    "code": "marketing.net_roas",
    "name": "平台归因净回报倍数",
    "domain": "marketing",
    "owners": ["101.marketing"],
    "responsible": "营销投放负责人",
    "summary": "整租户平台归因净回款除以同一投放范围的消耗。",
    "grain": "活动×平台渠道×归因日",
    "unit": "ratio",
    "definition": {
      "formula": "Σ(归因支付分 − 归因累计退款分) / Σ(完整消耗分)",
      "components": "分子为最新可见归因净额；分母为七区消耗额",
      "aggregation": "在请求粒度重算总分子/总分母。",
      "event_time": "cohort_date 对齐 report_date",
      "timezone": "Asia/Shanghai",
      "calendar": "公历自然日，ISO 周",
      "window": "[start,end)",
      "known_at": "available_at <= as_of",
      "exceptions": "PLATFORM_LAST_CLICK_7D 模型版本 1；取最新可见报表版，包括 UNKNOWN。零消耗、缺报、区域访问各有状态。",
      "dimensions": ["day", "campaign", "channel"],
      "filters": ["campaign", "channel"],
      "display": "总分子 / 总分母，显示四位小数倍数",
      "numerator": "同活动日最新可见归因支付分减累计退款分",
      "denominator": "同活动日计划七区最新可见消耗分之和",
      "additivity": "non_additive"
    },
    "aliases": ["净 ROAS", "广告投放净回报倍数", "广告 ROI"],
    "binding": {
      "sources": ["campaign", "channel", "campaign_attribution_daily", "campaign_daily"],
      "fragments": ["net-roas"],
      "access": "all_regions",
      "watermarks": [],
      "start": "2023-01-01",
      "end": "2026-01-01",
      "statuses": [
        "ATTRIBUTION_MISSING",
        "ATTRIBUTION_UNKNOWN",
        "SPEND_INCOMPLETE",
        "MULTIPLE_GAPS",
        "ZERO_SPEND",
        "NO_ACTIVITY",
        "PERIOD_NOT_CLOSED"
      ]
    }
  },
  {
