      "dimensions": ["day", "channel", "region", "site"],
      "filters": ["channel", "region", "site"],
      "display": "加总分后除以 100，以人民币元保留两位",
      "additivity": "additive_at_declared_grain"
    },
    "aliases": ["净 GMV", "退款后成交额", "扣退款销售额"],
    "binding": {
      "sources": ["payment", "refund", "order_header", "source_watermark"],
      "fragments": ["payments", "net-cash", "cash-dimensions", "watermarks", "additive"],
      "access": "regional",
      "watermarks": ["OMS"],
      "start": "2023-01-01",
      "end": "2026-04-01",
      "statuses": ["SOURCE_DELAYED", "COVERAGE_UNKNOWN", "NO_FACTS"]
    }
  },
