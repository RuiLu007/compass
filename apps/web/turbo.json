{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "passThroughEnv": ["$TURBO_EXTENDS$", "COMPASS_DOCUMENTS_ROOT", "COMPASS_DOCUMENTS_PIN_DIR"]
    },
    "test:e2e": {
      "passThroughEnv": [
        "$TURBO_EXTENDS$",
        "WEB_TEST_WORKFLOW",
        "WEB_TEST_TOOL_RUNTIME",
        "DURABLE_MATRIX_FILE"
      ]
    },
    "build": {
      "dependsOn": ["^build", "//#contracts"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "//#contracts"]
    }
  }
}
